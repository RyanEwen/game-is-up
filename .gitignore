# Stack template (Web)
node_modules/
dist/

# Project rules
# Vite's dependency cache, written into apps/web/.vite by the dev server
.vite/
# Log files written by local runs
*.log
# The server's real compose file, copied from compose.example.yml and never committed
/compose.yml
# Generated third-party notices, rebuilt by every web build from the lockfile
/apps/web/public/THIRD-PARTY-NOTICES.txt
# Personal Claude Code settings; the tracked project settings are .claude/settings.json
.claude/settings.local.json

# Shared block (HYG-6), from winui-app-kit build/shared.gitignore. Paste it unchanged as the last part
# of every repo's .gitignore, so no earlier line can un-ignore what it covers. Change it in the kit.
/.artifacts/
/.windows-build/
.secrets/
.aws/
.env
.env.*
!.env*.example
tmp/
.backups/
*.pfx
*.cer
*.der
*.keystore
*.jks
local.properties
.vs/
.idea/
.DS_Store
Thumbs.db
