# Stack template (Web)
node_modules/
dist/

# Project rules
# Vite's dependency cache, written into apps/web/.vite by the dev server
.vite/
# Log files written by local runs
*.log
# compose.yml is never tracked (CONF-11): production is compose.server.yml, dev is compose.dev.yml
/compose.yml
# Host-specific production values, kept only on the server the deploy adds them on
/compose.override.yml
# The Prisma client, generated into the API's source tree by `npm run db:generate`
/apps/api/src/generated/
# Generated third-party notices, rebuilt by every web build from the lockfile
/apps/web/public/THIRD-PARTY-NOTICES.txt
# Nested git worktrees (a repo's worktrees live in .worktrees/<name>/)
/.worktrees/
# Personal Claude Code settings; the tracked project settings are .claude/settings.json
.claude/settings.local.json

# Shared block (HYG-6), from winui-app-kit build/shared.gitignore. Paste it unchanged as the last part
# of every repo's .gitignore, so no earlier line can un-ignore what it covers. Change it in the kit.
/.artifacts/
/.windows-build/
.secrets/
.aws/
.env
.env.*
!.env*.example
tmp/
.backups/
*.pfx
*.cer
*.der
*.keystore
*.jks
local.properties
.vs/
.idea/
.DS_Store
Thumbs.db
