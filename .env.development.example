# Development environment example
# Typical local flow: web on 5173, API on 4000, browser calling the API directly.

DATABASE_URL=postgresql://postgres:postgres@db:5432/game_is_up?schema=public
API_PORT=4000
SESSION_SECRET=change-me

CLIENT_ORIGIN=http://localhost:5173
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback
STEAM_CALLBACK_URL=http://localhost:4000/api/auth/steam/callback
VITE_API_BASE_URL=http://localhost:4000

# Optional in development. Useful when invite links should point at a public URL.
VITE_PUBLIC_APP_URL=

# Keep local Discord OAuth enabled with the client vars below, but leave the bot token empty
# unless this environment should run the live Discord presence bot and DM sender.
# Use DISCORD_BOT_MODE=rest when you want local Discord DM access and read-only server/member
# browsing without competing with the production gateway connection. Gateway-only features such
# as presence tracking and interactive Discord prompts stay disabled in that mode.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_BOT_MODE=rest
DISCORD_SERVER_ID=
STEAM_WEB_API_KEY=
RAWG_API_KEY=

# Comma-separated list of handles that should have admin access (debug view).
ADMIN_HANDLES=
