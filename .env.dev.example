# Development environment example: copy to .env for local overrides.
# Devkit's runner overlays the database URL, ports and origins for each checkout,
# so most values here only matter when running with DEVKIT=0 on fixed ports.
# Typical fixed-port flow: web on 5173, API on 4000, browser calling the API directly.

# PostgreSQL connection; the local default for the development database container.
DATABASE_URL=postgresql://postgres:postgres@db:5432/game_is_up?schema=public
# Port the API listens on.
API_PORT=4000
# Required. Signs session and OAuth state cookies; at least 16 characters (for example: openssl rand -hex 32).
SESSION_SECRET=

# Origin the web app is served from; the API allows requests and redirects back to it.
CLIENT_ORIGIN=http://localhost:5173
# Discord OAuth redirect URI; must match one registered in the Discord developer portal.
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback
# Steam OpenID return URL used when linking a Steam account.
STEAM_CALLBACK_URL=http://localhost:4000/api/auth/steam/callback
# API origin the web app calls; empty means same-origin /api.
VITE_API_BASE_URL=http://localhost:4000

# Optional. Public URL that invite links point at, when it differs from the local origin.
VITE_PUBLIC_APP_URL=

# Discord application credentials for OAuth sign-in (Developer Portal > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Verifies Event Webhooks signatures (Developer Portal > General Information > Public Key).
DISCORD_PUBLIC_KEY=
# Bot token. Leave empty unless this environment should send DMs or browse servers.
DISCORD_BOT_TOKEN=
# rest: DMs and read-only server browsing without opening a gateway connection, so production
# keeps the live gateway. gateway: presence tracking and interactive prompts (one environment only).
DISCORD_BOT_MODE=rest
# Guild id of the Game's Up Discord server, where calls can create temporary channels.
DISCORD_SERVER_ID=
# Steam Web API key for library import (https://steamcommunity.com/dev/apikey).
STEAM_WEB_API_KEY=
# RAWG API key for game catalog search; without it only locally known games are searchable.
RAWG_API_KEY=

# Comma-separated handles that get admin access (the debug view).
ADMIN_HANDLES=

# Deploy target for `npm run deploy:prod`, run from this workspace: the SSH host (an alias from
# your SSH config works) and the checkout path on the server. See docs/deployment.md.
DEPLOY_SSH_HOST=
DEPLOY_REPO_PATH=
