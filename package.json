{
  "name": "game-is-up",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.9"
  },
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @game-is-up/shared && npm run build --workspace @game-is-up/api && npm run build --workspace @game-is-up/web",
    "deploy:prod": "node --env-file-if-exists=.env scripts/deploy/deploy-over-ssh.mjs",
    "db:wait": "node scripts/dev/wait-for-db.mjs",
    "dev": "devkit run node scripts/dev/run-dev.mjs",
    "dev:cleanup": "devkit cleanup --yes",
    "dev:background": "npm run dev -- --background",
    "dev:down": "npm run dev -- --down",
    "dev:bootstrap": "devkit bootstrap",
    "dev:doctor": "devkit doctor",
    "dev:prepare-worktree": "devkit prepare",
    "dev:fresh": "devkit run node scripts/dev/run-dev.mjs --fresh",
    "dev:host": "devkit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/dev/run-tests.mjs",
    "test:integration": "npm run test:integration --workspace @game-is-up/api",
    "typecheck": "npm run typecheck --workspace @game-is-up/shared && npm run build --workspace @game-is-up/shared && npm run typecheck --workspace @game-is-up/api && npm run typecheck --workspace @game-is-up/web",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run prisma:validate --workspace @game-is-up/api",
    "db:generate": "npm run prisma:generate --workspace @game-is-up/api",
    "db:push": "npm run prisma:db:push --workspace @game-is-up/api",
    "db:validate": "npm run prisma:validate --workspace @game-is-up/api",
    "db:migrate": "npm run prisma:migrate:dev --workspace @game-is-up/api --",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @game-is-up/api",
    "db:migrate:bootstrap": "npm run prisma:migrate:bootstrap --workspace @game-is-up/api",
    "db:seed": "npm run prisma:seed --workspace @game-is-up/api",
    "web:icons:export": "node scripts/dev/generate-brand-icons.mjs",
    "notices": "node scripts/dev/generate-third-party-notices.mjs"
  },
  "devDependencies": {
    "@dynamic-solutions-canada/devkit": "github:Dynamic-Solutions-Canada/devkit#v0.18.1",
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^9.2.5",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.0.0",
    "opentype.js": "^2.0.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
