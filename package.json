{
  "name": "game-is-up",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "start:prod": "npm run db:migrate:deploy && exec node apps/api/dist/index.js",
    "build": "npm run build --workspace @game-is-up/shared && npm run build --workspace @game-is-up/api && npm run build --workspace @game-is-up/web",
    "deploy:prod": "node --env-file-if-exists=.env scripts/deploy/deploy-over-ssh.mjs",
    "db:wait": "devkit-wait-for-db",
    "dev": "devkit run node scripts/dev/run-dev.mjs",
    "dev:cleanup": "devkit cleanup --yes",
    "dev:background": "npm run dev -- --background",
    "dev:down": "npm run dev -- --down",
    "dev:bootstrap": "devkit bootstrap",
    "dev:doctor": "devkit doctor",
    "dev:prepare-worktree": "devkit prepare && npm run --if-present dev:postprepare",
    "dev:fresh": "devkit run node scripts/dev/run-dev.mjs --fresh",
    "dev:container": "node scripts/dev/dev-container.mjs",
    "dev:postprepare": "lefthook install",
    "dev:host": "devkit",
    "lint": "eslint .",
    "check:devkit": "devkit-init --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test DATABASE_URL=postgresql://unit-tests@127.0.0.1:1/unit_tests_never_connect DISCORD_BOT_TOKEN= STEAM_WEB_API_KEY= RAWG_API_KEY= devkit-test",
    "test:api": "NODE_ENV=test DATABASE_URL=postgresql://unit-tests@127.0.0.1:1/unit_tests_never_connect DISCORD_BOT_TOKEN= STEAM_WEB_API_KEY= RAWG_API_KEY= devkit-test apps/api",
    "test:integration": "NODE_ENV=test DISCORD_BOT_TOKEN= STEAM_WEB_API_KEY= RAWG_API_KEY= devkit-test --integration",
    "typecheck": "npm run typecheck --workspace @game-is-up/shared && npm run build --workspace @game-is-up/shared && npm run typecheck --workspace @game-is-up/api && npm run typecheck --workspace @game-is-up/web",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run prisma:validate --workspace @game-is-up/api && npm run check:devkit",
    "db:generate": "npm run prisma:generate --workspace @game-is-up/api",
    "db:push": "npm run prisma:db:push --workspace @game-is-up/api",
    "db:validate": "npm run prisma:validate --workspace @game-is-up/api",
    "db:migrate": "npm run prisma:migrate:dev --workspace @game-is-up/api --",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @game-is-up/api",
    "db:migrate:bootstrap": "npm run prisma:migrate:bootstrap --workspace @game-is-up/api",
    "db:seed": "npm run prisma:seed --workspace @game-is-up/api",
    "web:icons:export": "node scripts/dev/generate-brand-icons.mjs",
    "notices": "node scripts/dev/generate-third-party-notices.mjs"
  },
  "devDependencies": {
    "@dynamic-solutions-canada/devkit": "github:Dynamic-Solutions-Canada/devkit#v0.20.2",
    "@eslint/js": "9.39.5",
    "@resvg/resvg-js": "2.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "concurrently": "9.2.5",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "16.5.0",
    "lefthook": "2.2.2",
    "opentype.js": "2.0.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "lefthook": false
  }
}
