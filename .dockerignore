# Build context for the root Dockerfile (DIST-12). Secrets are excluded at every depth (SEC-7):
# Docker matches a bare pattern only at the context root.
.git
.github
.tools
.vscode
.worktrees
**/node_modules
**/dist
coverage
**/*.log

# Secrets and local state, at every depth.
**/.env
**/.env.*
!**/.env*.example
**/.secrets/
**/.aws/
**/*.pfx
**/*.cer
**/*.der
**/*.keystore
**/*.pem
**/*.key
.windows-build/
tmp/
.backups/
.artifacts/
site-backups/
