{
  "name": "game-is-up",
  "dockerComposeFile": [
    "compose.yml"
  ],
  "service": "workspace",
  "runServices": ["workspace", "db"],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/workspace/game-is-up",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind"
  ],
  "forwardPorts": [5173, 4000, 5432],
  "remoteEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@db:5432/game_is_up?schema=public",
    "API_PORT": "4000",
    "CLIENT_ORIGIN": "http://localhost:5173",
    "SESSION_SECRET": "devcontainer-session-secret",
    "DISCORD_CALLBACK_URL": "http://localhost:4000/api/auth/discord/callback"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "Prisma.prisma",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "eslint.useFlatConfig": true
      }
    }
  },
  "postCreateCommand": "git config --global --add safe.directory /workspace/game-is-up && npm install && npm run db:generate",
  "postStartCommand": "npm run db:wait"
}