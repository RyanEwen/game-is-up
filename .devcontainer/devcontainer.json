{
  "name": "game-is-up",
  "dockerComposeFile": [
    "compose.yml",
    "compose.persist.yml"
  ],
  "service": "workspace",
  "runServices": ["workspace", "db"],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/workspace/game-is-up",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "remoteEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@db:5432/game_is_up?schema=public",
    "API_PORT": "4000",
    "CLIENT_ORIGIN": "http://localhost:5173",
    "SESSION_SECRET": "devcontainer-session-secret",
    "DISCORD_CALLBACK_URL": "http://localhost:4000/api/auth/discord/callback",
    // Lets the PostgreSQL extension (and terminal psql) authenticate to the dev
    // DB with no prompt: the preconfigured connection in .vscode/settings.json
    // uses authenticationType "None" and sends no password, so libpq falls back
    // to PGPASSWORD. Same throwaway `postgres` credential as DATABASE_URL above.
    "PGPASSWORD": "postgres"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "eslint.useFlatConfig": true
      }
    }
  },
  "postCreateCommand": ".devcontainer/fix-volume-perms.sh && git config --global --add safe.directory /workspace/game-is-up && npm install && npm run db:generate",
  "postStartCommand": "npm run db:wait"
}