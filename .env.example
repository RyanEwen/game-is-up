# The app always uses Docker-backed Postgres over the Compose network.
DATABASE_URL=postgresql://postgres:postgres@db:5432/game_is_up?schema=public
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PORT=80
# If a host Nginx instance already owns port 80, set PORT to an alternate host port such as 8080.
# Optional: set to an empty string for same-origin API requests behind a reverse proxy.
VITE_API_BASE_URL=http://localhost:4000
# Optional: used for in-app invite links when the current app origin is not publicly shareable.
VITE_PUBLIC_APP_URL=
SESSION_SECRET=change-me
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback
DISCORD_BOT_TOKEN=
RAWG_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Production Docker defaults:
# - docker compose up --build publishes the web app on http://localhost:${PORT:-80}
# - inside the web container, unprivileged Nginx listens on 8080 and Docker maps the host port to it
# - if host Nginx is already bound to :80 or :443, remap PORT to something like 8080 and proxy to that upstream
# - set CLIENT_ORIGIN to your public app URL, for example https://gameisup.example.com
# - set DISCORD_CALLBACK_URL to ${CLIENT_ORIGIN}/api/auth/discord/callback
