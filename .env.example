# Outside the devcontainer, the default local PostgreSQL URL is localhost:5432.
# Inside the devcontainer, DATABASE_URL is injected automatically to use the Compose db service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game_is_up?schema=public
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional: used for in-app invite links when the current app origin is not publicly shareable.
VITE_PUBLIC_APP_URL=
SESSION_SECRET=change-me
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback
DISCORD_BOT_TOKEN=
RAWG_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
