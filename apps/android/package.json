{
  "name": "@game-is-up/android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "adb:reverse": "bash ../../scripts/dev/android-adb-reverse.sh",
    "android:init": "cap add android",
    "copy": "cap copy android",
    "ensure": "bash ../../scripts/dev/ensure-android-project.sh",
    "assemble:debug": "npm run ensure && cd android && ./gradlew assembleDebug",
    "install:debug": "npm run ensure && cd android && ./gradlew installDebug",
    "install:debug:usb": "npm run adb:reverse && npm run install:debug",
    "sync": "cap sync android",
    "open": "cap open android",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^7.1.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.1.0",
    "@types/node": "^22.13.14"
  }
}
