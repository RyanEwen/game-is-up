{
  "name": "@game-is-up/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:db:push": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@db:5432/game_is_up?schema=public} prisma db push --force-reset",
    "prisma:migrate:dev": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@db:5432/game_is_up?schema=public} prisma migrate dev",
    "prisma:migrate:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@db:5432/game_is_up?schema=public} prisma migrate deploy",
    "prisma:migrate:bootstrap": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@db:5432/game_is_up?schema=public} node ../../scripts/dev/bootstrap-prisma-migrations.mjs",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@db:5432/game_is_up?schema=public} prisma generate",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@db:5432/game_is_up?schema=public} prisma validate",
    "prisma:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@db:5432/game_is_up?schema=public} tsx prisma/seed.ts"
  },
  "dependencies": {
    "@game-is-up/shared": "0.1.0",
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "discord.js": "^14.26.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3"
  }
}
