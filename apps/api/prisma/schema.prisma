generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  DISCORD
  STEAM
}

enum DiscordActivityType {
  PLAYING
  COMPETING
}

enum GameIntentType {
  WISHLIST
  INTERESTED
  PLAYING_NOW
  COMPLETED
}

enum ProfileVisibility {
  FRIENDS_ONLY
  SIGNED_IN_USERS
  PRIVATE
}

enum PlayIntentScope {
  FRIENDS_ONLY
  MUTUAL_FRIENDS
  SPECIFIC_FRIENDS
  SPECIFIC_FRIENDS_LIST
  SPECIFIC_DISCORD_SERVER
}

enum PlayIntentSelectionMode {
  ENTIRE_LIBRARY
  SELECTED_GAMES
}

enum PlayIntentDiscordSpaceStatus {
  REQUESTED
  PROVISIONING
  ACTIVE
  RETAINED
  DELETE_REQUESTED
  DELETED
  PROVISION_FAILED
}

enum PlayIntentDiscordSpaceAccessSource {
  CREATOR
  AUDIENCE_SYNC
  INTERESTED_RESPONSE
  MANUAL_SHARE
}

enum NotificationType {
  FRIEND_PLAYING
  MUTUAL_FRIEND
  SYSTEM
  SCHEDULED_PLAY_INTENT_CHECK_IN
  SCHEDULED_PLAY_INTENT_CONFIRMED
  SCHEDULED_PLAY_INTENT_REMINDER
}

enum NotificationResponseChoice {
  JOIN
  DECLINE
  EXPIRED
  CONFIRMED
  CANCELED
}

enum DiscordAutoPlayPromptStatus {
  SENT
  SKIPPED
  FAILED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum DiscordInviteAttributionKind {
  DIRECT
  SERVER
}

enum ReportReason {
  ABUSE
  SPAM
  INAPPROPRIATE_PROFILE
}

model User {
  id                                 String                              @id @default(uuid())
  handle                             String                              @unique
  displayName                        String
  email                              String?                             @unique
  avatarUrl                          String?
  bio                                String                              @default("")
  timezoneId                         String                              @default("Etc/UTC") @map("timezoneLabel")
  usualAvailability                  String?
  discordAutoPromptPlayIntent        Boolean                             @default(true)
  isAdmin                            Boolean                             @default(false)
  visibility                         ProfileVisibility                   @default(FRIENDS_ONLY)
  lastSeenAt                         DateTime                            @default(now())
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  identities                         UserIdentity[]
  discordServers                     DiscordServerMembership[]
  discordServerPreferences           DiscordServerPreference[]
  discordActivityObservations        DiscordActivityObservation[]
  gameInterests                      UserGameInterest[]
  platformAliases                    UserPlatformAlias[]
  gameAliases                        UserGameAlias[]
  friendsGiven                       Friend[]                            @relation("friends_given")
  friendsReceived                    Friend[]                            @relation("friends_received")
  blocksGiven                        Block[]                             @relation("blocks_given")
  blocksReceived                     Block[]                             @relation("blocks_received")
  playIntents                        PlayIntent[]
  targetedPlayIntents                PlayIntentTargetFriend[]            @relation("play_intent_target_friend")
  friendsLists                       FriendsList[]
  friendsListMemberships             FriendsListMember[]                 @relation("friends_list_member")
  mutesGiven                         PlayIntentMute[]                    @relation("mutes_given")
  mutesReceived                      PlayIntentMute[]                    @relation("mutes_received")
  notifications                      Notification[]                      @relation("notification_recipient")
  discordAutoPlayPrompts             DiscordAutoPlayPrompt[]
  acceptedDiscordInvites             DiscordInviteAttribution[]          @relation("discord_invite_acceptances")
  sentDiscordInvites                 DiscordInviteAttribution[]          @relation("discord_invite_senders")
  reportsFiled                       Report[]                            @relation("reporter")
  reportsReceived                    Report[]                            @relation("reported")
  playIntentDiscordSpaceAccessGrants PlayIntentDiscordSpaceAccessGrant[]
}

model UserIdentity {
  id                          String       @id @default(uuid())
  userId                      String
  provider                    AuthProvider
  providerUserId              String
  email                       String?
  grantedScopes               String[]     @default([])
  discordAccessToken          String?
  discordRefreshToken         String?
  discordAccessTokenExpiresAt DateTime?
  lastDiscordGuildsSyncAt     DateTime?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  user                        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model DiscordServer {
  id                         String                          @id
  name                       String
  iconHash                   String?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  memberships                DiscordServerMembership[]
  preferences                DiscordServerPreference[]
  inviteAttributions         DiscordInviteAttribution[]
  playIntentTargetSelections PlayIntentTargetDiscordServer[]
  activityObservations       DiscordActivityObservation[]
  observedGames              DiscordObservedGame[]
  autoPlayPrompts            DiscordAutoPlayPrompt[]
}

model DiscordInviteAttribution {
  id                   String                       @id @default(uuid())
  acceptedUserId       String
  inviterUserId        String?
  inviterDiscordUserId String?
  inviterLabel         String?
  serverId             String?
  serverName           String?
  hintedMemberCount    Int?
  kind                 DiscordInviteAttributionKind
  acceptedAt           DateTime                     @default(now())
  acceptedUser         User                         @relation("discord_invite_acceptances", fields: [acceptedUserId], references: [id], onDelete: Cascade)
  inviterUser          User?                        @relation("discord_invite_senders", fields: [inviterUserId], references: [id], onDelete: SetNull)
  server               DiscordServer?               @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([acceptedUserId, acceptedAt])
  @@index([inviterUserId, acceptedAt])
  @@index([serverId, acceptedAt])
}

model DiscordServerMembership {
  id        String        @id @default(uuid())
  userId    String
  serverId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  server    DiscordServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId])
}

model DiscordServerPreference {
  id                 String        @id @default(uuid())
  userId             String
  serverId           String
  includeInDiscovery Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  server             DiscordServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId, includeInDiscovery])
}

model Game {
  id                          String                       @id @default(uuid())
  slug                        String                       @unique
  title                       String
  coverUrl                    String?
  description                 String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  sources                     GameSource[]
  aliases                     GameAlias[]
  platforms                   GamePlatform[]
  discordActivityObservations DiscordActivityObservation[]
  observedOnDiscord           DiscordObservedGame[]
  interests                   UserGameInterest[]
  userAliases                 UserGameAlias[]
  playIntentGames             PlayIntentGame[]
  notifications               Notification[]
  autoPlayPrompts             DiscordAutoPlayPrompt[]
}

model GamePlatform {
  id            String   @id @default(uuid())
  gameId        String
  platformLabel String
  createdAt     DateTime @default(now())
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, platformLabel])
  @@index([platformLabel])
}

model GameSource {
  id         String    @id @default(uuid())
  gameId     String
  source     String
  externalId String
  canonical  Boolean   @default(false)
  syncedAt   DateTime?
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model GameAlias {
  id              String   @id @default(uuid())
  gameId          String
  alias           String
  createdByUserId String?
  createdAt       DateTime @default(now())
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, alias])
}

model UserGameInterest {
  id           String                     @id @default(uuid())
  userId       String
  gameId       String
  intentType   GameIntentType
  availability String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game                       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platforms    UserGameInterestPlatform[]

  @@unique([userId, gameId])
  @@index([gameId, intentType])
}

model UserGameInterestPlatform {
  id                 String           @id @default(uuid())
  userGameInterestId String
  platformLabel      String
  createdAt          DateTime         @default(now())
  userGameInterest   UserGameInterest @relation(fields: [userGameInterestId], references: [id], onDelete: Cascade)

  @@unique([userGameInterestId, platformLabel])
  @@index([platformLabel])
}

model Friend {
  id             String   @id @default(uuid())
  userId         String
  friendedUserId String
  createdAt      DateTime @default(now())
  user           User     @relation("friends_given", fields: [userId], references: [id], onDelete: Cascade)
  friendedUser   User     @relation("friends_received", fields: [friendedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, friendedUserId])
}

model Block {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())
  user          User     @relation("blocks_given", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("blocks_received", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
}

model FriendsList {
  id          String              @id @default(uuid())
  userId      String
  name        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     FriendsListMember[]
  playIntents PlayIntent[]        @relation("play_intent_target_friends_list")

  @@unique([userId, name])
  @@index([userId])
}

model FriendsListMember {
  id           String      @id @default(uuid())
  listId       String
  friendUserId String
  createdAt    DateTime    @default(now())
  list         FriendsList @relation(fields: [listId], references: [id], onDelete: Cascade)
  friendUser   User        @relation("friends_list_member", fields: [friendUserId], references: [id], onDelete: Cascade)

  @@unique([listId, friendUserId])
  @@index([friendUserId])
}

model PlayIntent {
  id                        String                          @id @default(uuid())
  userId                    String
  selectionMode             PlayIntentSelectionMode         @default(SELECTED_GAMES)
  headline                  String
  note                      String                          @default("")
  voiceChannelId            String?
  voiceChannelName          String?
  creatorDiscordDmChannelId String?
  creatorDiscordDmMessageId String?
  windowStartsAt            DateTime
  windowEndsAt              DateTime
  scope                     PlayIntentScope                 @default(MUTUAL_FRIENDS)
  targetFriendsListId       String?
  createdAt                 DateTime                        @default(now())
  expiresAt                 DateTime
  deletedAt                 DateTime?
  user                      User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetFriendsList         FriendsList?                    @relation("play_intent_target_friends_list", fields: [targetFriendsListId], references: [id], onDelete: SetNull)
  targetDiscordServers      PlayIntentTargetDiscordServer[]
  games                     PlayIntentGame[]
  platforms                 PlayIntentPlatform[]
  targetFriends             PlayIntentTargetFriend[]
  discordSpace              PlayIntentDiscordSpace?
  autoPrompts               DiscordAutoPlayPrompt[]         @relation("auto_prompt_play_intent")
  notifications             Notification[]

  @@index([userId, expiresAt])
  @@index([selectionMode, expiresAt])
  @@index([deletedAt])
}

model PlayIntentDiscordSpace {
  id                  String                              @id @default(uuid())
  playIntentId        String                              @unique
  serverId            String
  status              PlayIntentDiscordSpaceStatus        @default(REQUESTED)
  roleId              String?
  roleName            String?
  categoryChannelId   String?
  categoryChannelName String?
  textChannelId       String?
  textChannelName     String?
  voiceChannelId      String?
  voiceChannelName    String?
  inviteCode          String?
  inviteUseCount      Int                                 @default(0)
  inviteUrl           String?
  provisionedAt       DateTime?
  lastActiveAt        DateTime?
  deleteAfter         DateTime?
  deleteRequestedAt   DateTime?
  deletedAt           DateTime?
  lastSyncError       String?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  playIntent          PlayIntent                          @relation(fields: [playIntentId], references: [id], onDelete: Cascade)
  accessGrants        PlayIntentDiscordSpaceAccessGrant[]

  @@index([serverId, status])
  @@index([status, deleteAfter])
}

model PlayIntentDiscordSpaceAccessGrant {
  id                String                             @id @default(uuid())
  spaceId           String
  userId            String
  source            PlayIntentDiscordSpaceAccessSource @default(AUDIENCE_SYNC)
  inServer          Boolean                            @default(false)
  inviteSentAt      DateTime?
  roleGrantedAt     DateTime?
  joinedViaInviteAt DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  space             PlayIntentDiscordSpace             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user              User                               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId, revokedAt])
  @@index([spaceId, inServer, revokedAt])
}

model PlayIntentTargetDiscordServer {
  id           String        @id @default(uuid())
  playIntentId String
  serverId     String
  createdAt    DateTime      @default(now())
  playIntent   PlayIntent    @relation(fields: [playIntentId], references: [id], onDelete: Cascade)
  server       DiscordServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([playIntentId, serverId])
  @@index([serverId])
}

model PlayIntentTargetFriend {
  id           String     @id @default(uuid())
  playIntentId String
  friendUserId String
  createdAt    DateTime   @default(now())
  playIntent   PlayIntent @relation(fields: [playIntentId], references: [id], onDelete: Cascade)
  friendUser   User       @relation("play_intent_target_friend", fields: [friendUserId], references: [id], onDelete: Cascade)

  @@unique([playIntentId, friendUserId])
  @@index([friendUserId])
}

model PlayIntentGame {
  id           String     @id @default(uuid())
  playIntentId String
  gameId       String
  createdAt    DateTime   @default(now())
  playIntent   PlayIntent @relation(fields: [playIntentId], references: [id], onDelete: Cascade)
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([playIntentId, gameId])
  @@index([gameId])
}

model PlayIntentPlatform {
  id            String     @id @default(uuid())
  playIntentId  String
  platformLabel String
  createdAt     DateTime   @default(now())
  playIntent    PlayIntent @relation(fields: [playIntentId], references: [id], onDelete: Cascade)

  @@unique([playIntentId, platformLabel])
  @@index([platformLabel])
}

model Notification {
  id                                  String                      @id @default(uuid())
  userId                              String
  triggeredByUserId                   String?
  playIntentId                        String?
  gameId                              String?
  type                                NotificationType
  title                               String
  body                                String
  readAt                              DateTime?
  responseChoice                      NotificationResponseChoice?
  respondedAt                         DateTime?
  deliveredAt                         DateTime?
  discordDmChannelId                  String?
  discordDmMessageId                  String?
  recipientResponseDiscordDmChannelId String?
  recipientResponseDiscordDmMessageId String?
  createdAt                           DateTime                    @default(now())
  user                                User                        @relation("notification_recipient", fields: [userId], references: [id], onDelete: Cascade)
  playIntent                          PlayIntent?                 @relation(fields: [playIntentId], references: [id], onDelete: SetNull)
  game                                Game?                       @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([playIntentId])
}

model Report {
  id             String       @id @default(uuid())
  reporterUserId String
  reportedUserId String
  reason         ReportReason
  note           String?
  createdAt      DateTime     @default(now())
  reporter       User         @relation("reporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reported       User         @relation("reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, createdAt])
}

model DiscordActivityObservation {
  id              String                 @id @default(uuid())
  userId          String
  gameId          String?
  sourceServerId  String?
  activityName    String
  applicationId   String?
  activityType    DiscordActivityType
  details         String?
  state           String?
  startedAt       DateTime?
  firstObservedAt DateTime               @default(now())
  lastObservedAt  DateTime               @default(now())
  endedAt         DateTime?
  isActive        Boolean                @default(true)
  rawPayload      Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game?                  @relation(fields: [gameId], references: [id], onDelete: SetNull)
  sourceServer    DiscordServer?         @relation(fields: [sourceServerId], references: [id], onDelete: SetNull)
  autoPlayPrompt  DiscordAutoPlayPrompt?

  @@index([userId, isActive, lastObservedAt])
  @@index([gameId, isActive, lastObservedAt])
  @@index([sourceServerId, isActive])
}

model DiscordAutoPlayPrompt {
  id                    String                      @id @default(uuid())
  userId                String
  gameId                String
  observationId         String                      @unique
  sourceServerId        String?
  status                DiscordAutoPlayPromptStatus
  statusDetail          String?
  dmError               String?
  friendRecipientCount  Int                         @default(0)
  networkRecipientCount Int                         @default(0)
  durationMinutes       Int?
  notifyScope           PlayIntentScope?
  deliveredAt           DateTime?
  respondedAt           DateTime?
  discordDmChannelId    String?
  discordDmMessageId    String?
  createdPlayIntentId   String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                  Game                        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  observation           DiscordActivityObservation  @relation(fields: [observationId], references: [id], onDelete: Cascade)
  sourceServer          DiscordServer?              @relation(fields: [sourceServerId], references: [id], onDelete: SetNull)
  createdPlayIntent     PlayIntent?                 @relation("auto_prompt_play_intent", fields: [createdPlayIntentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdPlayIntentId])
}

model DiscordObservedGame {
  id              String              @id @default(uuid())
  discordUserId   String
  gameId          String
  sourceServerId  String?
  activityName    String
  applicationId   String?
  activityType    DiscordActivityType
  firstObservedAt DateTime            @default(now())
  lastObservedAt  DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  game            Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sourceServer    DiscordServer?      @relation(fields: [sourceServerId], references: [id], onDelete: SetNull)

  @@unique([discordUserId, gameId])
  @@index([discordUserId, lastObservedAt])
  @@index([sourceServerId, lastObservedAt])
}

model UserPlatformAlias {
  id         String   @id @default(uuid())
  userId     String
  platform   String
  aliasValue String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

model UserGameAlias {
  id         String   @id @default(uuid())
  userId     String
  gameId     String
  aliasValue String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
}

model PlayIntentMute {
  id          String   @id @default(uuid())
  userId      String
  mutedUserId String
  createdAt   DateTime @default(now())
  user        User     @relation("mutes_given", fields: [userId], references: [id], onDelete: Cascade)
  mutedUser   User     @relation("mutes_received", fields: [mutedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedUserId])
  @@index([userId])
}
