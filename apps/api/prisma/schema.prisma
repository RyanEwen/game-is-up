generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  DISCORD
  STEAM
}

enum DiscordActivityType {
  PLAYING
  COMPETING
}

enum GameIntentType {
  WISHLIST
  INTERESTED
  PLAYING_NOW
  COMPLETED
}

enum ProfileVisibility {
  FRIENDS_ONLY
  SIGNED_IN_USERS
  PRIVATE
}

enum PlayIntentScope {
  FRIENDS_ONLY
  MUTUAL_FRIENDS
  SPECIFIC_FRIENDS
}

enum PlayIntentSelectionMode {
  ENTIRE_LIBRARY
  SELECTED_GAMES
}

enum NotificationType {
  FRIEND_PLAYING
  MUTUAL_FRIEND
  SYSTEM
}

enum DiscordAutoPlayPromptStatus {
  SENT
  SKIPPED
  FAILED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ReportReason {
  ABUSE
  SPAM
  INAPPROPRIATE_PROFILE
}

model User {
  id                String             @id @default(uuid())
  handle            String             @unique
  displayName       String
  email             String?            @unique
  avatarUrl         String?
  bio               String             @default("")
  timezoneId        String             @default("Etc/UTC") @map("timezoneLabel")
  usualAvailability String?
  discordAutoPromptPlayIntent Boolean   @default(true)
  visibility        ProfileVisibility  @default(FRIENDS_ONLY)
  lastSeenAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  identities        UserIdentity[]
  discordServers    DiscordServerMembership[]
  discordServerPreferences DiscordServerPreference[]
  discordActivityObservations DiscordActivityObservation[]
  gameInterests     UserGameInterest[]
  friendsGiven      Friend[]           @relation("friends_given")
  friendsReceived   Friend[]           @relation("friends_received")
  blocksGiven       Block[]            @relation("blocks_given")
  blocksReceived    Block[]            @relation("blocks_received")
  playIntents       PlayIntent[]
  targetedPlayIntents PlayIntentTargetFriend[] @relation("play_intent_target_friend")
  notifications     Notification[]     @relation("notification_recipient")
  discordAutoPlayPrompts DiscordAutoPlayPrompt[]
  reportsFiled      Report[]           @relation("reporter")
  reportsReceived   Report[]           @relation("reported")
}

model UserIdentity {
  id                 String       @id @default(uuid())
  userId             String
  provider           AuthProvider
  providerUserId     String
  email              String?
  grantedScopes      String[]     @default([])
  lastDiscordGuildsSyncAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model DiscordServer {
  id            String                   @id
  name          String
  iconHash      String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  memberships   DiscordServerMembership[]
  preferences   DiscordServerPreference[]
  activityObservations DiscordActivityObservation[]
  observedGames DiscordObservedGame[]
  autoPlayPrompts DiscordAutoPlayPrompt[]
}

model DiscordServerMembership {
  id          String         @id @default(uuid())
  userId      String
  serverId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  server      DiscordServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId])
}

model DiscordServerPreference {
  id                  String         @id @default(uuid())
  userId              String
  serverId            String
  includeInDiscovery  Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  server              DiscordServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId, includeInDiscovery])
}

model Game {
  id              String             @id @default(uuid())
  slug            String             @unique
  title           String
  coverUrl        String?
  description     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sources         GameSource[]
  aliases         GameAlias[]
  platforms       GamePlatform[]
  discordActivityObservations DiscordActivityObservation[]
  observedOnDiscord DiscordObservedGame[]
  interests       UserGameInterest[]
  playIntentGames PlayIntentGame[]
  notifications   Notification[]
  autoPlayPrompts DiscordAutoPlayPrompt[]
}

model GamePlatform {
  id            String   @id @default(uuid())
  gameId        String
  platformLabel String
  createdAt     DateTime @default(now())
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, platformLabel])
  @@index([platformLabel])
}

model GameSource {
  id           String   @id @default(uuid())
  gameId       String
  source       String
  externalId   String
  canonical    Boolean  @default(false)
  syncedAt     DateTime?
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
}

model GameAlias {
  id                 String   @id @default(uuid())
  gameId             String
  alias              String
  createdByUserId    String?
  createdAt          DateTime @default(now())
  game               Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, alias])
}

model UserGameInterest {
  id              String                     @id @default(uuid())
  userId          String
  gameId          String
  intentType      GameIntentType
  availability    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game                       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platforms       UserGameInterestPlatform[]

  @@unique([userId, gameId])
  @@index([gameId, intentType])
}

model UserGameInterestPlatform {
  id                 String           @id @default(uuid())
  userGameInterestId String
  platformLabel      String
  createdAt          DateTime         @default(now())
  userGameInterest   UserGameInterest @relation(fields: [userGameInterestId], references: [id], onDelete: Cascade)

  @@unique([userGameInterestId, platformLabel])
  @@index([platformLabel])
}

model Friend {
  id              String   @id @default(uuid())
  userId          String
  friendedUserId  String
  createdAt       DateTime @default(now())
  user            User     @relation("friends_given", fields: [userId], references: [id], onDelete: Cascade)
  friendedUser    User     @relation("friends_received", fields: [friendedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, friendedUserId])
}

model Block {
  id             String   @id @default(uuid())
  userId         String
  blockedUserId  String
  createdAt      DateTime @default(now())
  user           User     @relation("blocks_given", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser    User     @relation("blocks_received", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
}

model PlayIntent {
  id             String                  @id @default(uuid())
  userId         String
  selectionMode  PlayIntentSelectionMode @default(SELECTED_GAMES)
  headline       String
  note           String                  @default("")
  windowStartsAt DateTime
  windowEndsAt   DateTime
  scope          PlayIntentScope         @default(MUTUAL_FRIENDS)
  createdAt      DateTime                @default(now())
  expiresAt      DateTime
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  games          PlayIntentGame[]
  platforms      PlayIntentPlatform[]
  targetFriends  PlayIntentTargetFriend[]
  autoPrompts    DiscordAutoPlayPrompt[] @relation("auto_prompt_play_intent")

  @@index([userId, expiresAt])
  @@index([selectionMode, expiresAt])
}

model PlayIntentTargetFriend {
  id           String     @id @default(uuid())
  playIntentId String
  friendUserId String
  createdAt    DateTime   @default(now())
  playIntent   PlayIntent @relation(fields: [playIntentId], references: [id], onDelete: Cascade)
  friendUser   User       @relation("play_intent_target_friend", fields: [friendUserId], references: [id], onDelete: Cascade)

  @@unique([playIntentId, friendUserId])
  @@index([friendUserId])
}

model PlayIntentGame {
  id           String     @id @default(uuid())
  playIntentId String
  gameId       String
  createdAt    DateTime   @default(now())
  playIntent   PlayIntent @relation(fields: [playIntentId], references: [id], onDelete: Cascade)
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([playIntentId, gameId])
  @@index([gameId])
}

model PlayIntentPlatform {
  id           String     @id @default(uuid())
  playIntentId String
  platformLabel String
  createdAt    DateTime   @default(now())
  playIntent   PlayIntent @relation(fields: [playIntentId], references: [id], onDelete: Cascade)

  @@unique([playIntentId, platformLabel])
  @@index([platformLabel])
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  triggeredByUserId String?
  gameId            String?
  type              NotificationType
  title             String
  body              String
  readAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime         @default(now())
  user              User             @relation("notification_recipient", fields: [userId], references: [id], onDelete: Cascade)
  game              Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

model Report {
  id              String       @id @default(uuid())
  reporterUserId  String
  reportedUserId  String
  reason          ReportReason
  note            String?
  createdAt       DateTime     @default(now())
  reporter        User         @relation("reporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reported        User         @relation("reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, createdAt])
}

model DiscordActivityObservation {
  id             String              @id @default(uuid())
  userId         String
  gameId         String?
  sourceServerId String?
  activityName   String
  applicationId  String?
  activityType   DiscordActivityType
  details        String?
  state          String?
  startedAt      DateTime?
  firstObservedAt DateTime           @default(now())
  lastObservedAt DateTime            @default(now())
  endedAt        DateTime?
  isActive       Boolean             @default(true)
  rawPayload     Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           Game?               @relation(fields: [gameId], references: [id], onDelete: SetNull)
  sourceServer   DiscordServer?      @relation(fields: [sourceServerId], references: [id], onDelete: SetNull)
  autoPlayPrompt DiscordAutoPlayPrompt?

  @@index([userId, isActive, lastObservedAt])
  @@index([gameId, isActive, lastObservedAt])
  @@index([sourceServerId, isActive])
}

model DiscordAutoPlayPrompt {
  id                     String                      @id @default(uuid())
  userId                 String
  gameId                 String
  observationId          String                      @unique
  sourceServerId         String?
  status                 DiscordAutoPlayPromptStatus
  statusDetail           String?
  dmError                String?
  friendRecipientCount   Int                         @default(0)
  networkRecipientCount  Int                         @default(0)
  durationMinutes        Int?
  notifyScope            PlayIntentScope?
  deliveredAt            DateTime?
  respondedAt            DateTime?
  createdPlayIntentId    String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game                   Game                        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  observation            DiscordActivityObservation  @relation(fields: [observationId], references: [id], onDelete: Cascade)
  sourceServer           DiscordServer?              @relation(fields: [sourceServerId], references: [id], onDelete: SetNull)
  createdPlayIntent      PlayIntent?                 @relation("auto_prompt_play_intent", fields: [createdPlayIntentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdPlayIntentId])
}

model DiscordObservedGame {
  id             String              @id @default(uuid())
  discordUserId  String
  gameId         String
  sourceServerId String?
  activityName   String
  applicationId  String?
  activityType   DiscordActivityType
  firstObservedAt DateTime           @default(now())
  lastObservedAt DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  game           Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sourceServer   DiscordServer?      @relation(fields: [sourceServerId], references: [id], onDelete: SetNull)

  @@unique([discordUserId, gameId])
  @@index([discordUserId, lastObservedAt])
  @@index([sourceServerId, lastObservedAt])
}