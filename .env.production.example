# Production Docker environment example
# The app always uses Docker-backed Postgres over the Compose network.
# docker compose up -d publishes the web app on http://localhost:${PORT:-8080}
# The public web container listens on 8080 internally.
# The default host publish port is 8080 so host Nginx can reverse proxy to it.
# If 8080 is already in use, pick another high port and proxy to that instead.

DATABASE_URL=postgresql://postgres:postgres@db:5432/game_is_up?schema=public
API_PORT=4000
SESSION_SECRET=change-me

CLIENT_ORIGIN=https://gameisup.example.com
DISCORD_CALLBACK_URL=https://gameisup.example.com/api/auth/discord/callback

# Leave empty for same-origin /api calls behind Nginx.
VITE_API_BASE_URL=

# Optional when invite links should point at a public canonical URL.
VITE_PUBLIC_APP_URL=https://gameisup.example.com

# Optional Cloudflare purge helper. The token should have Zone:Cache Purge permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Optional override for the URLs purged by npm run cache:purge:cloudflare.
# Defaults to VITE_PUBLIC_APP_URL, then CLIENT_ORIGIN.
# CLOUDFLARE_PURGE_BASE_URL=https://gameisup.example.com

# Optional comma-separated extra paths or absolute URLs to purge after deploy.
# CLOUDFLARE_PURGE_PATHS=/,/index.html,/discover

# Optional emergency mode. Prefer targeted purges unless you really need a full flush.
# CLOUDFLARE_PURGE_EVERYTHING=false

# Host publish port for the public web container.
PORT=8080

# Production can keep Discord OAuth enabled with these client vars.
# Set the bot token only in the one environment that should run the live Discord bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
RAWG_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
