# Server environment example: copy to .env in the server checkout, beside compose.yml.
# docker compose up -d publishes the web app on http://localhost:${PORT:-8080}; the public web
# container listens on 8080 internally, so host Nginx can reverse proxy to that port.
# If 8080 is already in use, pick another high port and proxy to that instead.

# Required. The database password; compose builds DATABASE_URL from it.
# It is placed in a URL, so use URL-safe characters (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=
# Port the API listens on inside its container.
API_PORT=4000
# Required. Signs session and OAuth state cookies; a long random value (for example: openssl rand -hex 32).
SESSION_SECRET=

# Public origin of the app; the API allows requests and redirects back to it.
CLIENT_ORIGIN=https://gameisup.example.com
# Discord OAuth redirect URI: CLIENT_ORIGIN plus /api/auth/discord/callback, registered in the portal.
DISCORD_CALLBACK_URL=https://gameisup.example.com/api/auth/discord/callback
# Steam OpenID return URL: CLIENT_ORIGIN plus /api/auth/steam/callback.
STEAM_CALLBACK_URL=https://gameisup.example.com/api/auth/steam/callback

# API origin the web app calls. Leave empty for same-origin /api calls behind Nginx.
VITE_API_BASE_URL=

# Optional. Public canonical URL that invite links point at.
VITE_PUBLIC_APP_URL=https://gameisup.example.com

# Host port the public web container is published on.
PORT=8080

# Discord application credentials for OAuth sign-in (Developer Portal > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Verifies Event Webhooks signatures (Developer Portal > General Information > Public Key).
DISCORD_PUBLIC_KEY=
# Bot token for DMs, presence and interactive prompts.
DISCORD_BOT_TOKEN=
# gateway in the one environment that owns the live bot connection (production).
DISCORD_BOT_MODE=gateway
# Guild id of the Game's Up Discord server, where calls can create temporary channels.
DISCORD_SERVER_ID=
# Steam Web API key for library import (https://steamcommunity.com/dev/apikey).
STEAM_WEB_API_KEY=
# RAWG API key for game catalog search; without it only locally known games are searchable.
RAWG_API_KEY=

# Comma-separated handles that get admin access (the debug view).
ADMIN_HANDLES=
