# Server environment example: copy to .env in the server checkout, beside compose.server.yml.
# The app container (the API, which also serves the web app) is reached through the server's
# shared nginx container, so no port is published on the host.

# Required. The database password; compose builds DATABASE_URL from it.
# It is placed in a URL, so use URL-safe characters (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=
# Port the API listens on inside its container.
API_PORT=4000
# Required. Signs session and OAuth state cookies; a long random value (for example: openssl rand -hex 32).
SESSION_SECRET=
# Required. Encrypts the stored Discord sign-in tokens: 32 random bytes in base64
# (generate with: openssl rand -base64 32). Keep it with the server's other secrets; if it is
# lost or changed, stored tokens are cleared at startup and players sign in with Discord again.
DISCORD_TOKEN_KEY=

# Required. Public origin of the app; the API allows requests and redirects back to it.
CLIENT_ORIGIN=https://gameisup.example.com
# Required. Discord OAuth redirect URI: CLIENT_ORIGIN plus /api/auth/discord/callback, registered in the portal.
DISCORD_CALLBACK_URL=https://gameisup.example.com/api/auth/discord/callback
# Steam OpenID return URL: CLIENT_ORIGIN plus /api/auth/steam/callback.
STEAM_CALLBACK_URL=https://gameisup.example.com/api/auth/steam/callback

# API origin the web app calls. Leave empty for same-origin /api calls (the API serves the app).
VITE_API_BASE_URL=

# Optional. Public canonical URL that invite links point at.
VITE_PUBLIC_APP_URL=https://gameisup.example.com


# Discord application credentials for OAuth sign-in (Developer Portal > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Verifies Event Webhooks signatures (Developer Portal > General Information > Public Key).
DISCORD_PUBLIC_KEY=
# Bot token for DMs, presence and interactive prompts.
DISCORD_BOT_TOKEN=
# gateway in the one environment that owns the live bot connection (production).
DISCORD_BOT_MODE=gateway
# Guild id of the Game's Up Discord server, where calls can create temporary channels.
DISCORD_SERVER_ID=
# Steam Web API key for library import (https://steamcommunity.com/dev/apikey).
STEAM_WEB_API_KEY=
# RAWG API key for game catalog search; without it only locally known games are searchable.
RAWG_API_KEY=

# Comma-separated handles that get admin access (the debug view).
ADMIN_HANDLES=

# Optional. Self-hosted, cookieless Umami analytics: the tracker script URL and this site's website id
# from the Umami dashboard. Analytics is on only when both are set; the CSP then allows the script's origin.
UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
UMAMI_WEBSITE_ID=

# Optional container limits (CTR-7); the defaults in compose.server.yml leave room over measured use.
API_MEM_LIMIT=512m
API_PIDS_LIMIT=128
DB_MEM_LIMIT=512m
DB_PIDS_LIMIT=256
